rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function validProfile() {
        return request.resource.data.keys().hasOnly(['uid', 'email', 'first_name', 'last_name', 'display_name', 'createdAt'])
          && request.resource.data.first_name is string && request.resource.data.first_name.size() <= 60
          && request.resource.data.last_name is string && request.resource.data.last_name.size() <= 60
          && request.resource.data.display_name is string && request.resource.data.display_name.size() <= 100;
      }
      allow read: if owner();
      allow create: if owner() && validProfile() && request.resource.data.uid == userId;
      allow update: if owner() && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['first_name', 'last_name', 'display_name']);
      allow delete: if owner();
    }
  }
}
